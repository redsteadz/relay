# Public application values
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Optional structured diagnostics. Leave unset in production by default.
# DEBUG=relay:api,relay:pipeline
# EXPO_PUBLIC_DEBUG=relay:mobile

# Exact Supabase Auth destinations. Hosted values must use stable HTTPS origins and no wildcards.
RELAY_AUTH_SITE_URL=http://localhost:3000
RELAY_AUTH_WEB_REDIRECT_URL=http://localhost:8081/auth/callback

# Hosted Supabase operator values. Keep credentials temporary and prefer a password manager.
RELAY_SUPABASE_ENVIRONMENT=hosted
RELAY_SUPABASE_PROJECT_REF=replace-with-hosted-project-ref
SUPABASE_DB_PASSWORD=replace-with-hosted-database-password

# Optional for hosted Auth Management API calls; omit while using stored CLI login.
# SUPABASE_ACCESS_TOKEN=replace-with-operator-access-token

# Server-only values. Never expose through NEXT_PUBLIC_ or EXPO_PUBLIC_.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
RELAY_CREDENTIAL_KEK_KEYRING={"activeVersion":1,"keys":{"1":"base64-encoded-32-byte-key"}}
RELAY_INGEST_SHARED_SECRET=local-development-only
RELAY_ALLOW_LOCAL_STUB=true
RELAY_PIPELINE_URL=http://127.0.0.1:8787
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_PUBSUB_AUDIENCE=http://localhost:3000/api/connectors/gmail/push
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=relay-pubsub@example-project.iam.gserviceaccount.com
GOOGLE_GMAIL_PUBSUB_TOPIC=projects/example-project/topics/relay-gmail
GOOGLE_PUBSUB_MESSAGE_RETENTION_SECONDS=604800
