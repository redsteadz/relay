{
  "name": "@relay/pipeline",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --env development --outdir dist/development && wrangler deploy --dry-run --env production --outdir dist/production",
    "clean": "rm -rf .wrangler dist coverage",
    "deploy:development": "wrangler deploy --env development",
    "deploy:production": "wrangler deploy --env production",
    "dev": "wrangler dev --env development",
    "lint": "eslint src tests",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@relay/contracts": "workspace:*",
    "@relay/crypto": "workspace:*",
    "@relay/domain": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260823.1",
    "@relay/config": "workspace:*",
    "wrangler": "4.125.0"
  }
}
