{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-pipeline-e2e-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "queues": {
    "producers": [
      {
        "binding": "INGRESS_QUEUE",
        "queue": "relay-ingress-e2e-local",
      },
    ],
    "consumers": [
      {
        "queue": "relay-ingress-e2e-local",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 1,
        "dead_letter_queue": "relay-ingress-dead-letter-e2e-local",
      },
      {
        "queue": "relay-ingress-dead-letter-e2e-local",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 1,
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TENANT_COORDINATOR",
        "class_name": "TenantCoordinator",
      },
    ],
  },
  "exports": {
    "TenantCoordinator": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "vars": {
    "RELAY_E2E_DEAD_LETTER_QUEUE": "relay-ingress-dead-letter-e2e-local",
    "RELAY_E2E_MODE": "true",
    "RELAY_E2E_RETENTION_NOW": "2030-01-01T00:00:00.000Z",
    "RELAY_ENVIRONMENT": "development",
  },
  "secrets": {
    "required": [
      "RELAY_CREDENTIAL_KEK_KEYRING",
      "RELAY_INGEST_SHARED_SECRET",
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY",
    ],
  },
}
