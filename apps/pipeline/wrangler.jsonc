{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-pipeline-production",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "analytics_engine_datasets": [
    {
      "binding": "PIPELINE_METRICS",
      "dataset": "relay_pipeline_production",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGRESS_QUEUE",
        "queue": "relay-ingress-production",
      },
    ],
    "consumers": [
      {
        "queue": "relay-ingress-production",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "relay-ingress-dead-letter-production",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TENANT_COORDINATOR",
        "class_name": "TenantCoordinator",
      },
    ],
  },
  "exports": {
    "TenantCoordinator": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "workflows": [
    {
      "name": "relay-action-workflow-production",
      "binding": "ACTION_WORKFLOW",
      "class_name": "ActionWorkflow",
    },
  ],
  "vars": {
    "RELAY_ENVIRONMENT": "production",
  },
  "secrets": {
    "required": [
      "RELAY_CREDENTIAL_KEK_KEYRING",
      "RELAY_INGEST_SHARED_SECRET",
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY",
    ],
  },
}
