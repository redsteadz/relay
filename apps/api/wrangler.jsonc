{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-api-production",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "relay.redsteadz.dpdns.org",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "relay-api-production",
    },
    {
      "binding": "PIPELINE",
      "service": "relay-pipeline-production",
    },
  ],
  "vars": {
    "NEXTJS_ENV": "production",
  },
  "observability": {
    "enabled": true,
  },
  "secrets": {
    "required": ["RELAY_INGEST_SHARED_SECRET", "RELAY_RECOVERY_SHARED_SECRET"],
  },
}
