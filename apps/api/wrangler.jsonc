{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-api-production",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "relay.redsteadz.dpdns.org",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "relay-api-production",
    },
    {
      "binding": "PIPELINE",
      "service": "relay-pipeline-production",
    },
  ],
  "vars": {
    "NEXTJS_ENV": "production",
    "RELAY_ENVIRONMENT": "production",
  },
  "observability": {
    "enabled": true,
  },
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "GOOGLE_PUBSUB_AUDIENCE",
      "GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL",
      "RELAY_CREDENTIAL_KEK_KEYRING",
      "RELAY_INGEST_SHARED_SECRET",
      "RELAY_RECOVERY_SHARED_SECRET",
      "SUPABASE_SERVICE_ROLE_KEY",
      "SUPABASE_URL",
    ],
  },
}
