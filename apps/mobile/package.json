{
  "name": "@relay/mobile",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "android:development:local": "node scripts/run-android-variant.mjs development",
    "android:sideload:local": "node scripts/run-android-variant.mjs sideload",
    "build": "expo export --platform web",
    "build-config:check": "node scripts/validate-build-config.mjs",
    "clean": "rm -rf .expo dist",
    "dev": "expo start --dev-client",
    "eas-build-post-install": "pnpm --dir ../.. --filter \"@relay/mobile^...\" build",
    "lint": "eslint app components features hooks lib modules scripts app.config.ts vitest.config.mjs",
    "start": "expo start --dev-client",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "57.0.13",
    "@expo/vector-icons": "15.0.2",
    "@hookform/resolvers": "5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@relay/contracts": "workspace:*",
    "@relay/domain": "workspace:*",
    "@relay/observability": "workspace:*",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-query": "5.102.8",
    "expo": "57.0.16",
    "expo-constants": "57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "57.0.15",
    "expo-font": "~57.0.2",
    "expo-linking": "57.0.7",
    "expo-router": "57.0.16",
    "expo-secure-store": "57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.86.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-paper": "5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.2",
    "@relay/config": "workspace:*",
    "@types/react": "19.2.14",
    "eslint-config-expo": "57.0.1"
  }
}
