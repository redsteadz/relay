{
  "name": "@relay/mobile",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "android:development:local": "node scripts/run-android-variant.mjs development",
    "android:sideload:local": "node scripts/run-android-variant.mjs sideload",
    "build": "expo export --platform web",
    "build-config:check": "node scripts/validate-build-config.mjs",
    "clean": "rm -rf .expo dist",
    "demo:android": "node scripts/build-demo-apk.mjs",
    "dev": "expo start --dev-client",
    "eas-build-post-install": "pnpm --dir ../.. --filter \"@relay/mobile^...\" build",
    "lint": "eslint app components e2e features hooks lib modules scripts app.config.ts vitest.config.mjs vitest.e2e.config.mjs",
    "start": "expo start --dev-client",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "58.0.17",
    "@expo/vector-icons": "15.1.1",
    "@hookform/resolvers": "7.0.3",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@relay/contracts": "workspace:*",
    "@relay/domain": "workspace:*",
    "@relay/observability": "workspace:*",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.107.0",
    "expo": "58.0.23",
    "expo-background-task": "58.0.12",
    "expo-constants": "58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "58.0.18",
    "expo-font": "~58.0.11",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "58.0.15",
    "expo-status-bar": "58.0.4",
    "expo-task-manager": "58.0.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.5.0",
    "react-native-paper": "5.15.4",
    "react-native-purchases": "11.0.1",
    "react-native-purchases-ui": "11.0.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.2",
    "@relay/config": "workspace:*",
    "@types/react": "19.3.0",
    "eslint-config-expo": "57.0.1"
  }
}
