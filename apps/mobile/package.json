{
  "name": "@relay/mobile",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "expo export --platform web",
    "build-config:check": "node scripts/validate-build-config.mjs",
    "clean": "rm -rf .expo dist",
    "dev": "expo start --dev-client",
    "eas-build-post-install": "pnpm --dir ../.. --filter @relay/contracts build",
    "lint": "eslint app components lib modules scripts app.config.ts",
    "start": "expo start --dev-client",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.13",
    "@relay/contracts": "workspace:*",
    "@supabase/supabase-js": "2.112.3",
    "expo": "57.0.16",
    "expo-constants": "57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "57.0.15",
    "expo-linking": "57.0.7",
    "expo-router": "57.0.16",
    "expo-secure-store": "57.0.1",
    "expo-status-bar": "57.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.0",
    "react-native-gesture-handler": "3.2.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.27.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.12.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.2",
    "@relay/config": "workspace:*",
    "@types/react": "19.2.18",
    "eslint-config-expo": "57.0.1"
  }
}
