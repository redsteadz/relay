{
  "name": "relay",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint && eslint scripts",
    "test": "turbo run test && node --test scripts/*.test.mjs",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm --filter @relay/api cf-typegen:check && NEXT_PUBLIC_SUPABASE_URL=https://relay-build.invalid NEXT_PUBLIC_SUPABASE_ANON_KEY=synthetic-build-only pnpm --filter @relay/api build:worker",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:auth:configure": "node --env-file-if-exists=.env scripts/configure-supabase-auth.mjs",
    "supabase:types": "node --env-file-if-exists=.env scripts/supabase-types.mjs write",
    "supabase:types:check": "node --env-file-if-exists=.env scripts/supabase-types.mjs check",
    "supabase:types:remote:check": "node --env-file-if-exists=.env scripts/supabase-types.mjs check-remote"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
